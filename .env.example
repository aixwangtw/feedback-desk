APP_NAME="Feedback System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3600

# --- Feedback Desk ---
# Serve the app only on this host (e.g. feedback.example.com). Leave empty to serve on any host.
FEEDBACK_DOMAIN=
# Filesystem disk for uploaded screenshots (keep it private).
FEEDBACK_DISK=local

# Shared owner account (the team's login). Without a password hash this account cannot sign in.
# Generate it with: php artisan feedback:account-password owner
FEEDBACK_OWNER_USERNAME=
FEEDBACK_OWNER_PASSWORD_HASH=
# Only used to block per-developer usernames that collide with the shared accounts.
FEEDBACK_CLIENT_USERNAME=
FEEDBACK_CLIENT_PASSWORD_HASH=

# Pre-fill the login forms. Off by default; when false no credentials are ever rendered.
FEEDBACK_LOGIN_PREFILL_ENABLED=false
# Owner/developer prefill (/owner/*/login and /login). Defaults to the flag above; set false to keep client prefill only.
# FEEDBACK_OWNER_LOGIN_PREFILL_ENABLED=false
FEEDBACK_OWNER_LOGIN_PREFILL_USERNAME=
FEEDBACK_OWNER_LOGIN_PREFILL_PASSWORD=

# UI wording. Examples: FEEDBACK_LABEL_CLIENT=老師  FEEDBACK_LABEL_OWNER=開發者
FEEDBACK_LABEL_CLIENT=客戶
FEEDBACK_LABEL_OWNER=開發團隊
FEEDBACK_PORTAL_TITLE=問題回報追蹤
# Landing page ("/"). Body defaults to a sentence that uses the owner label above.
FEEDBACK_HOME_TITLE=問題回報
FEEDBACK_HOME_EYEBROW=Feedback Desk
FEEDBACK_HOME_HEADING=問題回報
# FEEDBACK_HOME_BODY=

# Public reporting: strangers file issues from the home page into one project.
# Active only when this slug names a project switched on with `php artisan feedback:public-reporting {slug} on`.
# 免登入客戶入口：指定專案代稱與客戶帳號 username，沒設定就全部要登入
FEEDBACK_GUEST_CLIENT_PROJECT=
FEEDBACK_GUEST_CLIENT_ACCOUNT=
# 已淘汰：開單分類改在各專案設定（我的帳號頁「專案設定」或 php artisan feedback:categories）。
# 只在升級時的 migration 讀一次，把舊的整站分類複製給既有專案。
FEEDBACK_REPORT_CATEGORIES=

FEEDBACK_HOME_PUBLIC_PROJECT=
# Short description shown above the form (empty = none).
# FEEDBACK_PUBLIC_INTRO=
# Links and notice on the public home. Each stays hidden while empty.
FEEDBACK_PUBLIC_GITHUB_URL=
FEEDBACK_PUBLIC_BLOG_URL=
FEEDBACK_PUBLIC_NOTICE=
# Per-IP limit on public submissions.
FEEDBACK_PUBLIC_THROTTLE_PER_MINUTE=3
FEEDBACK_PUBLIC_THROTTLE_PER_HOUR=20
# Per-IP limit on messages that public reporters leave on their own reports, and the attachment cap per report.
FEEDBACK_PUBLIC_MESSAGE_THROTTLE_PER_MINUTE=5
FEEDBACK_PUBLIC_MESSAGE_THROTTLE_PER_HOUR=30
FEEDBACK_PUBLIC_MAX_ATTACHMENTS=15
# Cloudflare Turnstile. Enabled only when both keys are set.
FEEDBACK_TURNSTILE_SITE_KEY=
FEEDBACK_TURNSTILE_SECRET_KEY=

# Experimental: let a local AI CLI work on reports automatically.
FEEDBACK_AUTOMATION_ENABLED=false
FEEDBACK_WORKSPACE_ROOT=
# Which CLI does the work: codex (default) or claude (Claude Code).
FEEDBACK_AUTOMATION_DRIVER=codex
FEEDBACK_CODEX_BINARY=codex
# Used when the driver is claude.
FEEDBACK_CLAUDE_BINARY=claude
# Empty = the CLI's default model.
FEEDBACK_CLAUDE_MODEL=
FEEDBACK_CLAUDE_MAX_TURNS=60
# Comma-separated tools Claude may use without asking. Bash is deliberately
# not included (Bash is only offered when a Bash rule is listed); add one, e.g.
# "Bash(php artisan test *)", only on an isolated worker.
FEEDBACK_CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep
# Optional token from `claude setup-token`. Leave empty to use the worker
# user's own `claude` login. Never commit a real value.
FEEDBACK_CLAUDE_OAUTH_TOKEN=
FEEDBACK_AUTOMATION_QUEUE=feedback-automation
FEEDBACK_AUTOMATION_TIMEOUT=3000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
