{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM"],
        "strict": true,
        "types": ["node"],
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "noUnusedLocals": true
    },
    "include": ["src/cli/**/*", "src/shared/**/*", "test/cli/**/*"]
}
