{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2023"],
        "strict": true,
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true
    },
    "include": ["src/worker/**/*", "src/shared/**/*", "test/worker/**/*"]
}
